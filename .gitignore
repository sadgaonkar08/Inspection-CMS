# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore env files (keep local secrets out of git), but allow templates.
/.env
/.env.*
!/.env.example
!/.env*.erb

# Runtime/Generated directories (keep locally, do not commit)
/log/
/tmp/
/storage/

# If you’re not maintaining a Rails test suite in this repo, keep it untracked.
/test/

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Rails encrypted credentials keys (multi-environment)
/config/credentials/*.key

# Private keys / cert bundles (avoid accidental commits)
*.pem
*.p12
*.pfx
*.key

# Local dev databases
/db/*.sqlite3
/db/*.sqlite3-*

# Python virtual environment
.venv/
/python/venv/
/python/.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Accidental/Generated artifacts
/inspection_test_output.docx
/e

# Presentation / local planning docs
/docs/PRESENTATION_WALKTHROUGH.md
/docs/AI_PROMPT_OVERHAUL_PLAN.md
/docs/PERFORMANCE_AUDIT.md
/docs/PROJECT_PAGES_REORG_PLAN.md
/docs/IMAGE_COMPRESSION_PLAN.md
/docs/CORE_LOCATOR_REORGANIZATION_PLAN.md
/docs/ADDED_CORE_LOCATOR.md
/docs/API_TOKEN_PRODUCTION_SETUP.md


# remore .idae folder
/.idea/*

# MCP server and Claude Code skill (local tooling, not for production)
/mcp-server/
/.claude/skills/

app_logs.zip
app_logs_latest.zip
app_logs/*
app_logs_latest/*