<div class="dashboard-container">
  <div class="dashboard-header">
    <div class="d-flex align-center gap-3">
      <h1 class="mb-0">Lot</h1>
      <% if @all_lots.size > 1 %>
        <select onchange="if(this.value) window.location.href=this.value;"
                class="form-control" style="width: auto; min-width: 160px; font-size: 1.1em; font-weight: 600;">
          <% @all_lots.each do |lot| %>
            <option value="<%= project_asphalt_lot_path(@project, lot) %>"
                    <%= "selected" if lot.id == @asphalt_lot.id %>>
              #<%= lot.lot_number %> &mdash; <%= lot.mix_type %> (<%= lot.plant %>)
            </option>
          <% end %>
        </select>
      <% else %>
        <h1 class="mb-0">#<%= @asphalt_lot.lot_number %></h1>
      <% end %>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "Edit", edit_project_asphalt_lot_path(@project, @asphalt_lot), class: "btn btn-secondary" %>
      <%= button_to "Delete", project_asphalt_lot_path(@project, @asphalt_lot), method: :delete,
          class: "btn btn-danger",
          form: { data: { turbo_confirm: "Delete this lot and all its sublots, lanes, and core generations?" } } %>
      <%= link_to "All Lots", project_path(@project, anchor: "asphalt-lots"), class: "btn btn-secondary" %>
    </div>
  </div>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <%# Lot Details %>
  <div class="form-card">
    <h3>Lot Details</h3>
    <div class="form-row">
      <div class="form-group">
        <strong>Plant:</strong> <%= @asphalt_lot.plant.presence || "-" %>
      </div>
      <div class="form-group">
        <strong>Mix Type:</strong> <%= @asphalt_lot.mix_type.presence || "-" %>
      </div>
      <div class="form-group">
        <strong>Lot Number:</strong> <%= @asphalt_lot.lot_number %>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <strong>Contractor:</strong> <%= @asphalt_lot.contractor.presence || "-" %>
      </div>
      <div class="form-group">
        <strong>Mix Design:</strong> <%= @asphalt_lot.mix_design.presence || "-" %>
      </div>
      <div class="form-group">
        <strong>PG:</strong> <%= @asphalt_lot.pg.presence || "-" %>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <strong>Paving Date:</strong> <%= @asphalt_lot.paving_date&.strftime("%B %d, %Y") || "-" %>
      </div>
      <div class="form-group">
        <strong>Total Tonnage:</strong>
        <%= @asphalt_lot.total_tonnage.present? ? "#{number_with_precision(@asphalt_lot.total_tonnage, precision: 2, strip_insignificant_zeros: true, delimiter: ',')} tons" : "-" %>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <strong>Description:</strong> <%= @asphalt_lot.description.presence || "-" %>
      </div>
    </div>
  </div>

  <%= render "pwl_analysis" %>

  <%# Sublots & Lanes %>
  <div class="form-card mt-5">
    <div class="d-flex justify-between align-center mb-4">
      <h3 class="mb-0">Sublots & Lanes</h3>
      <div class="d-flex gap-3">
        <% if @asphalt_lot.asphalt_sublots.any? %>
          <%= link_to "Generate All Core Locations",
                new_project_asphalt_lot_core_generation_path(@project, @asphalt_lot),
                class: "btn btn-primary" %>
          <% if @asphalt_lot.core_generations.any? %>
            <%= link_to "View Last Generation",
                  project_asphalt_lot_core_generation_path(@project, @asphalt_lot, @asphalt_lot.core_generations.order(created_at: :desc).first),
                  class: "btn btn-secondary" %>
          <% end %>
        <% end %>
        <%= link_to "Add Sublots",
              new_project_asphalt_lot_bulk_setup_path(@project, @asphalt_lot),
              class: "btn btn-outline-primary" %>
      </div>
    </div>

    <% if @generation_history.present? %>
      <div class="mb-4">
        <h4 class="mb-2">Core Generation History</h4>
        <table class="modern-table table-compact">
          <thead>
            <tr>
              <th>Seed</th>
              <th>Generated</th>
              <th>Cores</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @generation_history.each do |generation| %>
              <tr>
                <td class="code-font"><%= generation.seed %></td>
                <td><%= generation.created_at.strftime("%b %d, %Y %H:%M") %></td>
                <td><%= generation.core_locations.size %></td>
                <td class="text-right">
                  <%= link_to "View",
                        project_asphalt_lot_core_generation_path(@project, @asphalt_lot, generation),
                        class: "btn btn-secondary btn-sm" %>
                  <%= link_to "Excel",
                        export_xlsx_project_asphalt_lot_core_generation_path(@project, @asphalt_lot, generation),
                        class: "btn btn-outline-primary btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @asphalt_lot.asphalt_sublots.any? %>
      <% @asphalt_lot.asphalt_sublots.order(:position).includes(:asphalt_lanes).each do |sublot| %>
        <div class="nested-entry-card card-accent--blue mb-3" data-controller="collapsible">
          <div class="d-flex justify-between align-center mb-3" data-action="click->collapsible#toggle" style="cursor: pointer;">
            <h4 class="mb-0">
              <span class="collapse-icon" data-collapsible-target="icon">&#9660;</span>
              <span class="status-badge status-in-progress" style="margin-right: 0.5rem;"><%= sublot.position %></span>
              Sublot <%= sublot.position %>
              <% total_ft = sublot.asphalt_lanes.sum(&:length_ft) %>
              <span class="text-muted" style="font-size: 0.85em; font-weight: normal;">
                &mdash; <%= sublot.asphalt_lanes.size %> lane<%= sublot.asphalt_lanes.size == 1 ? '' : 's' %>, <%= number_with_precision(total_ft, precision: 1) %> ft
              </span>
            </h4>
            <div class="d-flex gap-2 align-center">
              <% lock_badge = { "none" => nil, "mat_only" => "Mat Locked", "joint_only" => "Joint Locked", "all" => "All Locked" }[sublot.core_lock_mode] %>
              <% if lock_badge %>
                <span class="status-badge status-revise" title="Lock: <%= sublot.core_lock_mode %>"><%= lock_badge %></span>
              <% end %>
              <% if sublot.asphalt_lanes.any? %>
                <%= button_to "Generate Cores",
                      create_for_sublot_project_asphalt_lot_core_generations_path(@project, @asphalt_lot, sublot_id: sublot.id),
                      method: :post,
                      class: "btn btn-secondary btn-sm",
                      disabled: sublot.lock_all? %>
              <% end %>
              <% %w[none mat_only joint_only all].each do |mode| %>
                <% label = { "none" => "None", "mat_only" => "Mat", "joint_only" => "Joint", "all" => "All" }[mode] %>
                <%= button_to label,
                      toggle_core_lock_project_asphalt_lot_asphalt_sublot_path(@project, @asphalt_lot, sublot, core_lock_mode: mode),
                      method: :patch,
                      class: "btn btn-sm #{sublot.core_lock_mode == mode ? 'btn-primary' : 'btn-secondary'}" %>
              <% end %>
            </div>
          </div>

          <div data-collapsible-target="content">
          <% if sublot.asphalt_lanes.any? %>
            <%= form_with url: bulk_update_lanes_project_asphalt_lot_asphalt_sublot_path(@project, @asphalt_lot, sublot),
                  method: :patch,
                  local: true do %>
              <table class="modern-table table-compact mb-0">
                <thead>
                  <tr>
                    <th>Lane</th>
                    <th>Length (ft)</th>
                    <th>Width (ft)</th>
                    <th style="width: 60px;">Delete</th>
                  </tr>
                </thead>
                <tbody>
                  <% sublot.asphalt_lanes.order(:position).each do |lane| %>
                    <tr>
                      <td class="font-bold">Lane <%= lane.position %></td>
                      <td><%= number_field_tag "lanes[#{lane.id}][length_ft]", lane.length_ft, step: 0.01, min: 0.01, class: "form-control form-control-sm", required: true %></td>
                      <td><%= number_field_tag "lanes[#{lane.id}][width_ft]", lane.width_ft, step: 0.01, min: 0.01, class: "form-control form-control-sm", required: true %></td>
                      <td>
                        <button type="submit"
                                form="delete-lane-<%= lane.id %>"
                                class="btn btn-sm btn-danger"
                                style="padding: 4px 8px;"
                                aria-label="Delete Lane <%= lane.position %>"
                                title="Delete Lane <%= lane.position %>">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="3" x2="13" y2="13"/><line x1="13" y1="3" x2="3" y2="13"/></svg>
                        </button>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <div class="mt-2" style="text-align: right;">
                <button type="submit" class="btn btn-sm btn-primary" title="Save all lane changes">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 4px;"><path d="M12.5 1.5h-9a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-7l-2-4z"/><polyline points="11.5,14.5 11.5,8.5 4.5,8.5 4.5,14.5"/><polyline points="4.5,1.5 4.5,5.5 10.5,5.5"/></svg>
                  Save
                </button>
              </div>
            <% end %>

            <% sublot.asphalt_lanes.order(:position).each do |lane| %>
              <%= form_with url: project_asphalt_lot_asphalt_sublot_asphalt_lane_path(@project, @asphalt_lot, sublot, lane),
                    method: :delete,
                    local: true,
                    html: { id: "delete-lane-#{lane.id}", style: "display:none;", data: { turbo_confirm: "Delete Lane #{lane.position}?" } } do %>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-muted">No lanes defined for this sublot.</p>
          <% end %>

          <%= render "lab_test_results/sublot_compact",
                rows: @lab_results_by_sublot_id[sublot.id],
                project: @project %>

          <%# Add Individual Lane Form %>
          <div class="mt-3">
            <details>
              <summary class="btn btn-sm btn-outline-primary">+ Add Lane</summary>
              <div class="mt-2 p-3" style="background: var(--bg-secondary, #f8f9fa); border-radius: 8px;">
                <%= form_with model: AsphaltLane.new,
                      url: project_asphalt_lot_asphalt_sublot_asphalt_lanes_path(@project, @asphalt_lot, sublot),
                      method: :post,
                      local: true,
                      class: "d-flex gap-3 align-center" do |f| %>
                  <div class="form-group mb-0">
                    <label class="form-label mb-1">Length (ft)</label>
                    <%= f.number_field :length_ft, step: 0.01, min: 0.01, class: "form-control form-control-sm", required: true, placeholder: "e.g. 500" %>
                  </div>
                  <div class="form-group mb-0">
                    <label class="form-label mb-1">Width (ft)</label>
                    <%= f.number_field :width_ft, step: 0.01, min: 0.01, class: "form-control form-control-sm", required: true, placeholder: "e.g. 12" %>
                  </div>
                  <%= f.submit "Add Lane", class: "btn btn-sm btn-primary", style: "align-self: flex-end;" %>
                <% end %>
              </div>
            </details>
          </div>
          </div><%# end collapsible content %>
        </div><%# end collapsible card %>
      <% end %>
    <% else %>
      <p class="text-muted">No sublots or lanes have been added yet. Use the "Add Sublots" button to add them.</p>
    <% end %>

    <% if @unmatched_lab_results.present? %>
      <div class="mt-4 pt-3" style="border-top: 1px solid var(--border-light, #e5e7eb);">
        <%= render "lab_test_results/sublot_compact",
              rows: @unmatched_lab_results,
              project: @project,
              title: "Lab Test Results (unmatched to any sublot)" %>
        <p class="text-muted-sm mt-2">
          These results are linked to this lot but their <code>sublot_number</code> doesn't match any existing sublot position.
          <%= link_to "Review on the lab results page", project_lab_test_results_path(@project), class: "link-primary" %>.
        </p>
      </div>
    <% end %>
  </div>

  <% if @latest_generation && @diagram_data %>
    <div class="form-card mt-5" data-controller="core-diagram"
         data-core-diagram-data-value="<%= @diagram_data.to_json %>">
      <div class="d-flex justify-between align-center mb-3">
        <h3 class="mb-0">Core Location Diagram</h3>
        <span class="text-muted" style="font-size: 0.85em;">
          Latest generation &mdash; <%= @latest_generation.core_locations.size %> cores
        </span>
      </div>
      <canvas data-core-diagram-target="canvas"></canvas>
    </div>
  <% end %>
</div>
