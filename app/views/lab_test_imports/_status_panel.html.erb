<% case import.status %>
<% when "pending" %>
  <div class="card">
    <div class="card-body text-center">
      <p class="mb-3 text-muted">Extracting data from PDF…</p>
      <div class="progress-track mx-auto" style="max-width: 480px;">
        <div class="progress-bar progress-bar-indeterminate"></div>
      </div>
      <p class="mt-3 mb-0 text-muted small">
        Elapsed: <span data-lab-test-import-target="elapsed">0:00</span>
      </p>
      <div class="alert alert-info mt-3 mb-0 d-none text-left" data-lab-test-import-target="stallWarning">
        <strong>Still working…</strong>
        Extraction is running in the background and will continue even if you leave this page. If you've been waiting more than a minute, click
        <%= link_to "refresh", project_lab_test_import_path(project, import), class: "alert-link", data: { turbo: false } %>
        to see the latest status — no need to re-upload.
      </div>
    </div>
  </div>

<% when "saved" %>
  <div class="alert alert-success">
    <strong>Saved.</strong>
    <%= import.row_count %> row(s) from <%= import.lab_name %> added to the results table.
    <% report_date = import.report_header["report_date"] %>
    <% if report_date.present? %>— report dated <%= report_date %><% end %>
  </div>

<% when "needs_review" %>
  <div class="alert alert-warning">
    <strong>Needs review.</strong>
    The parser did not fully extract this report. Review the extracted rows below; approve to save or reject to discard.
  </div>

  <% if import.extraction_errors.any? %>
    <div class="card mb-3">
      <div class="card-header">Extraction errors (<%= import.extraction_errors.size %>)</div>
      <ul class="list-group list-group-flush">
        <% import.extraction_errors.each do |err| %>
          <li class="list-group-item"><code><%= err %></code></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if import.parsed_data.any? %>
    <div class="card mb-3">
      <div class="card-header">Extracted rows (<%= import.parsed_data.size %>)</div>
      <div class="table-responsive">
        <table class="table table-sm table-striped mb-0">
          <thead>
            <tr>
              <% import.parsed_data.first.keys.each do |k| %>
                <th><%= k %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% import.parsed_data.each do |row| %>
              <tr>
                <% row.each_value do |v| %>
                  <td><%= v.is_a?(Array) ? v.join(", ") : v %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="d-flex">
    <%= button_to "Approve", approve_project_lab_test_import_path(project, import),
          method: :patch, class: "btn btn-success mr-2",
          data: { confirm: "Approve and save these rows to the results table?" } %>
    <%= button_to "Reject", reject_project_lab_test_import_path(project, import),
          method: :patch, class: "btn btn-danger",
          data: { confirm: "Reject this import?" } %>
  </div>

<% when "rejected" %>
  <div class="alert alert-danger">
    <strong>Rejected.</strong>
    <% if import.extraction_errors.any? %>
      <ul class="mb-0 mt-2">
        <% import.extraction_errors.each do |err| %>
          <li><code><%= err %></code></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <%= link_to "Upload again", new_project_lab_test_import_path(project), class: "btn btn-primary" %>
<% end %>
