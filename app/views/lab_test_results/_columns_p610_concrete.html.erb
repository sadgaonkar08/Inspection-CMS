<thead>
  <tr>
    <th>Report Date</th>
    <th>Daily Report</th>
    <th>Lab ID</th>
    <th>Set</th>
    <th>Sampled</th>
    <th>Supplier</th>
    <th>Mix #</th>
    <th class="text-right">Cylinders (tested / total)</th>
    <th class="text-right">Avg Strength</th>
    <th class="text-right">Specified (28-day min)</th>
    <th class="text-center">Result</th>
    <th class="text-right">Actions</th>
  </tr>
</thead>
<tbody>
  <% rows.each do |r| %>
    <% d = r.data || {} %>
    <tr>
      <td><%= r.report_date %></td>
      <td>
        <% if r.report %>
          <%= link_to report_option_label(r.report), report_path(r.report), class: "link-primary" %>
        <% else %>
          <span class="text-muted">—</span>
        <% end %>
      </td>
      <td class="cell-primary"><%= d["lab_id_number"] %></td>
      <td><%= d["set_number"] %></td>
      <td><%= d["date_sampled"] %></td>
      <td><%= d["supplier"].presence || "—" %></td>
      <td><%= d["mix_number"].presence || "—" %></td>
      <td class="text-right"><%= d["num_tested"] %> / <%= d["num_cylinders"] %></td>
      <td class="text-right">
        <% if d["avg_strength_psi"] %>
          <strong><%= number_with_delimiter(d["avg_strength_psi"].to_i) %> psi</strong>
          <% if d["avg_strength_at_days"] %>
            <div class="text-muted small">
              at <%= d["avg_strength_at_days"] %> day<%= "s" if d["avg_strength_at_days"] != 1 %>
              <% if d["avg_strength_source"] == "computed_from_tested_cylinders" %>
                <span title="Computed from early-break cylinders; 28-day breaks still pending">*</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <span class="text-muted">—</span>
        <% end %>
      </td>
      <td class="text-right">
        <% if d["specified_strength_psi"] %>
          <%= number_with_delimiter(d["specified_strength_psi"].to_i) %> psi
        <% else %>
          <span class="text-muted">—</span>
        <% end %>
      </td>
      <td class="text-center"><span class="badge badge-<%= result_badge_class(r.result) %>"><%= result_label(r.result) %></span></td>
      <td class="text-right">
        <%= link_to "Edit", edit_project_lab_test_result_path(project, r), class: "link-primary mr-3" %>
        <%= link_to "Delete", project_lab_test_result_path(project, r),
              class: "btn-clear inline-danger p-0",
              data: { turbo_method: :delete, turbo_confirm: "Delete lab ID #{d['lab_id_number']}?" } %>
      </td>
    </tr>
  <% end %>
</tbody>
