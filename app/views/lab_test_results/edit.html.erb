<div class="dashboard-container">
  <div class="dashboard-header">
    <h1>Edit Lab Test Result</h1>
    <%= link_to "Back", project_lab_test_results_path(@project), class: "btn btn-secondary" %>
  </div>

  <div class="form-card">
    <%= form_with(model: [@project, @result], local: true) do |form| %>
      <% if @result.errors.any? %>
        <div class="error-explanation">
          <ul>
            <% @result.errors.each { |e| %><li><%= e.full_message %></li><% } %>
          </ul>
        </div>
      <% end %>

      <div class="form-row">
        <div class="form-group col-md-4">
          <label>Sublot</label>
          <%= form.text_field :sublot_number, class: "form-control" %>
        </div>
        <div class="form-group col-md-4">
          <label>Test Date</label>
          <%= form.date_field :test_date, class: "form-control" %>
        </div>
        <div class="form-group col-md-4">
          <label>Result</label>
          <%= form.select :result, LabTestResult.results.keys.map { |k| [k.capitalize, k] }, {}, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <label>Notes</label>
        <%= form.text_area :notes, class: "form-control", rows: 4 %>
      </div>

      <div class="card mb-3">
        <div class="card-header">Raw extracted data (read-only)</div>
        <div class="card-body">
          <pre class="mb-0"><%= JSON.pretty_generate(@result.data || {}) %></pre>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
