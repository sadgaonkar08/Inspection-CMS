<div class="dashboard-container">
  <div class="dashboard-header">
    <h1>Lab Test Results</h1>
    <div>
      <%= link_to "Back to Project", project_path(@project, anchor: "lab-tests"), class: "btn btn-secondary" %>
      <% if @spec_code == "P-610" %>
        <%= link_to "Export Excel (QAQC Summary)",
              export_xlsx_project_lab_test_results_path(@project, spec_code: "P-610"),
              class: "btn btn-secondary" %>
      <% elsif %w[P-401 P-403].include?(@spec_code) %>
        <%= link_to "Export CSV",
              export_csv_project_lab_test_results_path(
                @project,
                spec_code: @spec_code,
                result: @result_filter,
                lot: @lot_filter,
                date_from: @date_from,
                date_to: @date_to
              ),
              class: "btn btn-secondary" %>
      <% end %>
      <%= link_to "Upload New Report", new_project_lab_test_import_path(@project), class: "btn btn-primary" %>
    </div>
  </div>

  <%= form_with url: project_lab_test_results_path(@project), method: :get, local: true, class: "card card-body mb-4" do %>
    <div class="form-row">
      <div class="form-group col-md-2">
        <label>Spec</label>
        <%= select_tag :spec_code,
              options_for_select([["All specs", nil]] + LabTestImport::SPEC_CODES.map { |c| [c, c] }, @spec_code),
              class: "form-control" %>
      </div>
      <div class="form-group col-md-2">
        <label>Result</label>
        <%= select_tag :result,
              options_for_select([["All", nil], ["Pass", "pass"], ["Fail", "fail"]], @result_filter),
              class: "form-control" %>
      </div>
      <div class="form-group col-md-2">
        <label>Lot</label>
        <%= select_tag :lot,
              options_for_select(
                @lot_filter_enabled ? [["All lots", nil]] + @available_lot_options : [["Not available", nil]],
                @lot_filter
              ),
              class: "form-control",
              disabled: !@lot_filter_enabled %>
      </div>
      <div class="form-group col-md-2">
        <label>From</label>
        <%= date_field_tag :date_from, @date_from, class: "form-control" %>
      </div>
      <div class="form-group col-md-2">
        <label>To</label>
        <%= date_field_tag :date_to, @date_to, class: "form-control" %>
      </div>
      <div class="form-group col-md-2 align-self-end">
        <%= submit_tag "Apply", class: "btn btn-primary" %>
        <%= link_to "Clear", project_lab_test_results_path(@project), class: "btn btn-link" %>
      </div>
    </div>
  <% end %>

  <% if @results.empty? %>
    <div class="alert alert-info">No results match your filters. Upload a lab report to get started.</div>
  <% else %>
    <% @results.group_by { |r| [r.spec_code, result_view_key(r)] }.each do |(spec, view_key), rows| %>
      <h3 class="mt-4"><%= result_view_label(spec, view_key) %> <span class="text-muted">(<%= rows.size %>)</span></h3>
      <div class="table-card mb-4">
        <div class="table-responsive">
          <table class="modern-table dashboard-table">
            <%= render "columns_#{view_key}", rows: rows, project: @project %>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
