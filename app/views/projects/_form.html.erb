<%= form_with(model: project, class: "contents") do |form| %>
  <% if project.errors.any? %>
    <div class="error-explanation">
      <h2><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h2>
      <ul>
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-card">
    <h2 class="form-section-title">Project Details</h2>

    <div class="form-row">
      <div class="form-group full-width">
        <%= form.label :name, "Project Name" %>
        <%= form.text_field :name, placeholder: "e.g. Runway 1R Rehabilitation" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= form.label :contract_number %>
        <%= form.text_field :contract_number, placeholder: "e.g. 8983.61" %>
      </div>
      <div class="form-group">
        <%= form.label :contract_days, "Contract Duration (Days)" %>
        <%= form.number_field :contract_days %>
      </div>
      <div class="form-group">
        <%= form.label :contract_start_date %>
        <%= form.date_field :contract_start_date %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= form.label :prime_contractor, "Prime Contractor" %>
        <%= form.text_field :prime_contractor %>
      </div>
      <div class="form-group">
        <%= form.label :project_manager, "Project Manager (PM)" %>
        <%= form.text_field :project_manager %>
      </div>
      <div class="form-group">
        <%= form.label :construction_manager, "Construction Manager (CM)" %>
        <%= form.text_field :construction_manager %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-card" style="width:100%; padding: 1rem; margin-top: 1rem; background: var(--bg-secondary, #f8f9fa); border-radius: 8px;">
        <h3 class="form-section-title" style="margin-bottom:0.5rem;">📍 Site Coordinates</h3>
        <p class="text-muted" style="margin-bottom:1rem; font-size:0.875rem;">Used to automatically fetch accurate weather data for inspection reports. Set once per project.</p>
        <div class="form-row">
          <div class="form-group">
            <%= form.label :latitude, "Latitude" %>
            <%= form.number_field :latitude, step: "any", placeholder: "e.g. 33.942536", id: "project_latitude" %>
          </div>
          <div class="form-group">
            <%= form.label :longitude, "Longitude" %>
            <%= form.number_field :longitude, step: "any", placeholder: "e.g. -118.408075", id: "project_longitude" %>
          </div>
        </div>
        <button type="button" class="btn btn-secondary" id="detect-project-location">
          📍 Detect My Location
        </button>
        <small class="text-muted" style="display:block; margin-top:0.5rem;">Or enter coordinates manually from Google Maps / site survey.</small>
      </div>
    </div>

    <div class="actions text-right mt-5">
      <%= form.submit class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

<%= javascript_tag nonce: true do %>
  (function() {
    var btn = document.getElementById('detect-project-location');
    if (!btn) return;
    btn.addEventListener('click', function() {
      if (!navigator.geolocation) { alert('Geolocation not supported by this browser.'); return; }
      btn.textContent = '📡 Locating...';
      btn.disabled = true;
      navigator.geolocation.getCurrentPosition(
        function(pos) {
          document.getElementById('project_latitude').value  = pos.coords.latitude.toFixed(6);
          document.getElementById('project_longitude').value = pos.coords.longitude.toFixed(6);
          btn.textContent = '✓ Location Detected';
          setTimeout(function() { btn.textContent = '📍 Detect My Location'; btn.disabled = false; }, 2000);
        },
        function() {
          alert('Unable to retrieve location. Please enter coordinates manually.');
          btn.textContent = '📍 Detect My Location';
          btn.disabled = false;
        }
      );
    });
  })();
<% end %>