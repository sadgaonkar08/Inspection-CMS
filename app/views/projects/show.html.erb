<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<% if alert %>
  <div class="alert alert-danger"><%= alert %></div>
<% end %>

<div class="dashboard-container" data-controller="tabs toggle-edit" data-tabs-active-value="overview">
  <div class="dashboard-header">
    <div>
      <h1><%= @project.name %></h1>
      <p class="text-muted mb-0">Contract #<%= @project.contract_number %> · PM: <%= @project.project_manager.presence || "-" %></p>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "Back to Projects", projects_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="directory-tab-bar">
    <button type="button" class="directory-tab-btn is-active" data-tabs-target="tab" data-tab="overview" data-action="tabs#switch">
      Overview
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="bid-items" data-action="tabs#switch">
      Bid Items
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="lab-tests" data-action="tabs#switch">
      Lab Tests
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="equipment" data-action="tabs#switch">
      Equipment
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="phases" data-action="tabs#switch">
      Phases
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="change-orders" data-action="tabs#switch">
      Change Orders
    </button>
    <button type="button" class="directory-tab-btn" data-tabs-target="tab" data-tab="asphalt-lots" data-action="tabs#switch">
      Asphalt Lots
    </button>
  </div>

  <div class="directory-panel" data-tabs-target="panel" data-tab="overview">
    <%= render "projects/overview_tab" %>
  </div>

  <% %w[bid-items lab-tests equipment phases change-orders asphalt-lots].each do |tab| %>
    <div class="directory-panel d-none" data-tabs-target="panel" data-tab="<%= tab %>">
      <%= turbo_frame_tag "tab-#{tab}", src: project_path(@project, tab: tab), loading: "lazy", target: "_top" do %>
        <p class="text-muted">Loading…</p>
      <% end %>
    </div>
  <% end %>
</div>
