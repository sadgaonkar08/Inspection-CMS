<%# Equipment Picker Modal - shell only; equipment options load lazily on first open. %>
<% project_context = report.project || (@project if defined?(@project)) %>

<dialog data-equipment-picker-target="modal" class="equipment-picker-modal">
  <div class="modal-header">
    <h3 class="mb-0">Select Equipment</h3>
    <button type="button" class="btn-clear" data-action="click->equipment-picker#closeModal">✕</button>
  </div>

  <div class="modal-body">
    <% if project_context %>
      <%= turbo_frame_tag "equipment_picker_options",
            data: {
              equipment_picker_target: "optionsFrame",
              lazy_src: equipment_picker_options_reports_path(project_id: project_context.id)
            } do %>
        <p class="text-muted-sm">Loading equipment…</p>
      <% end %>
    <% else %>
      <div class="equipment-empty-state">
        <p class="text-muted">Save the project before adding equipment.</p>
      </div>
    <% end %>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn-secondary" data-action="click->equipment-picker#closeModal">Cancel</button>
    <button type="button"
            class="btn-primary"
            data-action="click->equipment-picker#createEntries"
            data-equipment-picker-target="createBtn"
            disabled></button>
  </div>
</dialog>
