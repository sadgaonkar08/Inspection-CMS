<template id="qa-template">
  <div class="nested-entry-card nested-fields mb-3">
    <div class="form-row form-row--compact align-end">
      <div class="form-group flex-2">
        <label class="text-muted-sm">Test Type</label>
        <select name="report[qa_entries_attributes][NEW_RECORD][qa_type]" class="w-full">
          <option value="">Select Test...</option>
          <% QaEntry.qa_types.keys.each do |k| %>
            <option value="<%= k %>"><%= k.humanize.titleize %></option>
          <% end %>
        </select>
      </div>
      <div class="form-group flex-2">
        <label class="text-muted-sm">Location</label>
        <input type="text" name="report[qa_entries_attributes][NEW_RECORD][location]" placeholder="Location" class="w-full">
      </div>
      <div class="form-group flex-1">
        <label class="text-muted-sm">Result</label>
        <select name="report[qa_entries_attributes][NEW_RECORD][result]" class="w-full">
          <option value="">Result...</option>
          <% QaEntry.results.keys.each do |k| %>
            <option value="<%= k %>"><%= k.humanize.gsub("Qa ", "").titleize %></option>
          <% end %>
        </select>
      </div>
      <div class="form-group flex-2">
        <label class="text-muted-sm">Remarks</label>
        <input type="text" name="report[qa_entries_attributes][NEW_RECORD][remarks]" placeholder="Remarks" class="w-full">
      </div>
      <div class="form-group d-flex align-end">
        <button type="button" class="remove-row-btn inline-danger mb-2" data-action="click->report-form#removeAssociation">Delete</button>
      </div>
    </div>
  </div>
</template>

<template id="crew-template">
  <div class="nested-entry-card nested-fields mb-3">
    <div class="form-row mb-2">
      <div class="form-group flex-2">
        <label>Contractor</label>
        <input type="text" name="report[crew_entries_attributes][NEW_RECORD][contractor]" placeholder="Contractor Name" class="auto-contractor">
      </div>
      <div class="form-group d-flex align-end">
        <button type="button" class="remove-row-btn inline-danger" data-action="click->report-form#removeAssociation">Delete</button>
      </div>
    </div>
    <div class="form-row form-row--compact">
      <div class="form-group form-group--count">
        <label class="text-sm">Supt</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][superintendent_count]" placeholder="0">
      </div>
      <div class="form-group form-group--count">
        <label class="text-sm">Foreman</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][foreman_count]" placeholder="0">
      </div>
      <div class="form-group form-group--count">
        <label class="text-sm">Survey</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][survey_count]" placeholder="0">
      </div>
      <div class="form-group form-group--count">
        <label class="text-sm">Operators</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][operator_count]" placeholder="0">
      </div>
      <div class="form-group form-group--count">
        <label class="text-sm">Laborers</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][laborer_count]" placeholder="0">
      </div>
      <div class="form-group form-group--count">
        <label class="text-sm">Electricians</label>
        <input type="number" name="report[crew_entries_attributes][NEW_RECORD][electrician_count]" placeholder="0">
      </div>
    </div>
  </div>
</template>

<template id="equipment-template">
  <div class="nested-entry-card nested-fields mb-2">
    <div class="form-row">
      <div class="form-group flex-2">
        <label class="text-muted-sm">Contractor</label>
        <input type="text" name="report[equipment_entries_attributes][NEW_RECORD][contractor]" placeholder="Contractor" class="auto-contractor w-full">
      </div>
      <div class="form-group flex-3">
        <label class="text-muted-sm">Make/Model</label>
        <% names = approved_equipment_names || report&.project&.approved_equipments&.pluck(:name) || [] %>
        <% if names.any? %>
          <select name="report[equipment_entries_attributes][NEW_RECORD][make_model]" class="equipment-select w-full">
            <option value="">Select Equipment</option>
            <% names.each do |name| %>
              <option value="<%= name %>"><%= name %></option>
            <% end %>
          </select>
        <% else %>
          <select name="report[equipment_entries_attributes][NEW_RECORD][make_model]" class="equipment-select w-full" disabled>
            <option value="">No approved equipment</option>
          </select>
        <% end %>
      </div>
      <div class="form-group flex-05">
        <label class="text-muted-sm">Qty</label>
        <input type="number" name="report[equipment_entries_attributes][NEW_RECORD][quantity]" placeholder="1" class="w-full">
      </div>
      <div class="form-group flex-1">
        <label class="text-muted-sm">Hours</label>
        <input type="number" name="report[equipment_entries_attributes][NEW_RECORD][hours]" step="0.5" placeholder="Hrs" class="w-full">
      </div>
      <div class="form-group d-flex align-end">
        <button type="button" class="remove-row-btn inline-danger mb-2" data-action="click->report-form#removeAssociation">Delete</button>
      </div>
    </div>
  </div>
</template>

<template id="placed-quantity-template">
  <%= fields_for :placed_quantities, PlacedQuantity.new, child_index: "NEW_RECORD" do |entry_form| %>
    <div class="nested-entry-card nested-fields">
       <div class="form-row mb-3">
         <div class="form-group flex-2">
           <label class="text-muted-sm">Bid Item</label>
           <select name="report[placed_quantities_attributes][NEW_RECORD][bid_item_id]" class="w-full" data-action="change->report-form#selectBidItem">
               <option value="">Select Item</option>
               <% if @report.project %>
                 <% @report.project.bid_items.order(:code).each do |bi| %>
                   <option value="<%= bi.id %>" data-unit="<%= bi.unit %>">
                     <%= bi.code %> - <%= bi.description %>
                   </option>
                 <% end %>
               <% else %>
                 <option disabled>Please save Project first...</option>
               <% end %>
           </select>
         </div>
         <div class="form-group">
           <label class="text-muted-sm">Quantity <span class="qty-unit"></span></label>
           <input class="w-full" type="number" step="0.01" placeholder="Qty" name="report[placed_quantities_attributes][NEW_RECORD][quantity]">
         </div>
         <div class="form-group">
           <label class="text-muted-sm">Change Order</label>
           <select name="report[placed_quantities_attributes][NEW_RECORD][change_order_id]" class="w-full">
             <option value="">Original Contract</option>
             <% if @report&.project %>
               <% @report.project.change_orders.active.order(:number).each do |co| %>
                 <option value="<%= co.id %>"><%= co.display_name %></option>
               <% end %>
             <% end %>
           </select>
         </div>
       </div>
       
       <div class="nested-row-container mb-3">
         <input type="hidden" name="report[placed_quantities_attributes][NEW_RECORD][checklist_answers]" class="checklist-answers-field" value="{}">
         <button type="button" class="remove-row-btn ml-auto" data-action="click->report-form#removeAssociation">Delete</button>
       </div>
       
       <div class="form-group">
         <input type="text" placeholder="Daily notes..." name="report[placed_quantities_attributes][NEW_RECORD][notes]" class="w-full">
       </div>
    </div>
  <% end %>
</template>

<template id="attachment-template">
  <div class="gallery-card nested-fields text-left attachment-card">
    <div class="attachment-header">
      <input type="file" name="report[report_attachments_attributes][NEW_RECORD][file]" class="form-control w-full">
    </div>
    <div class="attachment-body">
      <input type="text" name="report[report_attachments_attributes][NEW_RECORD][caption]" placeholder="Enter caption..." class="form-control w-full">
      <div class="attachment-actions">
         <button type="button" class="remove-row-btn inline-danger text-xs" data-action="click->report-form#removeAssociation">Remove</button>
      </div>
    </div>
  </div>
</template>
