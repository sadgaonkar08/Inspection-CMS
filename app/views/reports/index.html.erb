<div class="dashboard-container">

  <div class="page-header">
    <div class="page-header-brand" aria-hidden="true">
      <%= image_tag "G_logo.png", alt: "", class: "page-header-logo", data: { action: "dblclick->ui#toggleTheme" }, style: "cursor: default; user-select: none;" %>
    </div>
    <div class="page-header-left">
      <h1 class="page-title">Reports</h1>
      <span class="page-header-sep">|</span>
      <%= form_with url: reports_path, method: :get, local: true, class: "context-form" do |f| %>
        <%= hidden_field_tag :status, params[:status] %>
        <%= hidden_field_tag :tab, params[:tab] %>
        <%= f.collection_select :project_id, current_user.accessible_projects, :id, :name,
            { include_blank: "All Projects", selected: params[:project_id] },
            { onchange: "this.form.submit()", class: "project-select-compact" } %>
      <% end %>
    </div>
    <div class="page-header-right">
      <%= link_to "Data View",
        data_view_reports_path(params.permit(:project_id)),
        class: "btn btn-clear btn-sm" %>
      <div class="header-secondary-actions">
        <%= link_to "Projects", projects_path, class: "btn btn-clear btn-sm" %>
        <% if user_signed_in? %>
          <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
        <% end %>
      </div>
      <details class="mobile-actions-menu-wrap">
        <summary class="btn btn-clear btn-sm">More</summary>
        <div class="mobile-actions-menu">
          <%= link_to "Projects", projects_path, class: "btn btn-clear btn-sm" %>
          <% if user_signed_in? %>
            <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-sm", form: { class: "mobile-actions-form" } %>
          <% end %>
        </div>
      </details>
    </div>
  </div>

  <div class="toolbar-row">
    
    <div class="dashboard-tabs">
      <% status_tabs = [
        { key: 'in_progress', label: Report.status_label(:in_progress) },
        { key: 'review', label: Report.status_label(:review) },
        { key: 'revise', label: Report.status_label(:revise) },
        { key: 'finalize', label: Report.status_label(:finalize) },
        { key: 'all', label: 'All' }
      ] %>

      <% status_tabs.each do |tab| %>
        <%= link_to reports_path(params.permit(:status, :inspector, :project_id, :start_date, :end_date, :bid_item_id, :result, :phase_id, :has_quantities, :spec_division, :spec_item_id, :tab).merge(status: tab[:key], tab: 'reports')),
            class: "tab-link #{'active' if params[:tab] != 'weekly_reports' && params[:tab] != 'data' && (params[:status] == tab[:key] || (params[:status].blank? && tab[:key] == 'in_progress'))}" do %>
          <%= tab[:label] %><% if tab[:key] == 'revise' && @has_revise_reports %><span class="tab-dot tab-dot-warning"></span><% end %>
        <% end %>
      <% end %>

      <span class="tab-separator">|</span>

      <%= link_to "Weekly Reports",
          weekly_reports_path(project_id: params[:project_id]),
          class: "tab-link" %>

    </div>

    <div class="toolbar-actions">
      <% if params[:tab] == 'imported' %>
        <%= link_to "Import DOCX", import_reports_path, class: "btn btn-primary btn-sm" %>
      <% else %>
        <%= link_to "+ New Report", new_report_path(project_id: params[:project_id]), class: "btn btn-primary btn-sm" %>
      <% end %>

      <% show_export = !(%w[in_progress review].include?(params[:status].to_s) || params[:status].blank?) && params[:tab] != 'weekly_reports' %>
      <% if show_export %>
        <div class="toolbar-secondary-actions">
          <%= link_to "Export CSV", reports_path(request.query_parameters.merge(format: :csv)), class: "btn btn-secondary btn-sm" %>
        </div>

        <details class="mobile-actions-menu-wrap">
          <summary class="btn btn-clear btn-sm">More</summary>
          <div class="mobile-actions-menu">
            <%= link_to "Export CSV", reports_path(request.query_parameters.merge(format: :csv)), class: "btn btn-secondary btn-sm" %>
          </div>
        </details>
      <% end %>
    </div>
  </div>

  <% filters_open = params[:search_text].present? || params[:inspector].present? || params[:result].present? || params[:start_date].present? || params[:end_date].present? || params[:bid_item_id].present? || params[:phase_id].present? || params[:has_quantities].present? || params[:spec_division].present? || params[:spec_item_id].present? %>
  <div class="filter-card filter-card-collapsible">
    <details class="filter-panel" <%= 'open' if filters_open %>>
      <summary>Filters and Search</summary>
      <div class="filter-panel-body">
        <%= form_with url: reports_path, method: :get, local: true, class: "search-form" do |form| %>
          <%= hidden_field_tag :status, params[:status] %>
          <%= hidden_field_tag :project_id, params[:project_id] %>
          <%= hidden_field_tag :tab, params[:tab] %>

          <div class="filter-grid">
            <div class="filter-group">
              <label>Search</label>
              <%= form.text_field :search_text, value: params[:search_text], placeholder: "Search text…", class: "form-input" %>
            </div>

            <div class="filter-group" data-controller="date-range">
              <label>Date range</label>

              <button type="button" class="btn btn-secondary w-full" data-action="click->date-range#open">
                <span data-date-range-target="buttonLabel">Any date</span>
              </button>

              <div class="modal-backdrop" data-date-range-target="modal" data-action="click->date-range#backdropClick" hidden>
                <div class="modal-card" role="dialog" aria-modal="true" aria-label="Select date range" data-action="click->date-range#stopPropagation">
                  <div class="modal-header">
                    <div class="modal-title">Date range</div>
                    <button type="button" class="btn btn-clear btn-sm" data-action="click->date-range#close">Close</button>
                  </div>

                  <div class="modal-body">
                    <div class="date-range-fields">
                      <div class="filter-group">
                        <label>Start</label>
                        <%= form.date_field :start_date, value: params[:start_date], class: "form-input", data: { "date-range-target": "start" } %>
                      </div>
                      <div class="filter-group">
                        <label>End</label>
                        <%= form.date_field :end_date, value: params[:end_date], class: "form-input", data: { "date-range-target": "end" } %>
                      </div>
                    </div>
                    <div class="text-muted-sm" style="margin-top: 8px;">Tip: leave End blank to search a single day.</div>
                  </div>

                  <div class="modal-footer">
                    <button type="button" class="btn btn-clear" data-action="click->date-range#clear">Clear</button>
                    <button type="button" class="btn btn-primary" data-action="click->date-range#apply">Done</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="filter-group">
              <label>Inspector</label>
              <%= form.text_field :inspector, value: params[:inspector], placeholder: "Name…", class: "form-input" %>
            </div>

            <div class="filter-group">
              <label>Result</label>
              <%= select_tag :result, options_for_select([['Pass', 'pass'], ['Fail', 'fail'], ['As Built', 'as_built'], ['Pending', 'pending']], params[:result]), prompt: "All results", class: "form-input" %>
            </div>

            <div class="filter-actions-row">
              <%= link_to "Clear", reports_path(status: params[:status], project_id: params[:project_id], tab: params[:tab]), class: "btn btn-clear" %>
              <%= form.submit "Search", class: "btn btn-primary" %>
            </div>
          </div>

          <% advanced_open = params[:bid_item_id].present? || params[:phase_id].present? || params[:has_quantities].present? || params[:spec_division].present? || params[:spec_item_id].present? %>
          <details class="advanced-filters" <%= 'open' if advanced_open %> data-controller="reports-filters">
            <summary>Advanced filters</summary>

            <div class="filter-grid">
              <div class="filter-group">
                <label>Contains item</label>
                <% items = params[:project_id].present? ? BidItem.where(project_id: params[:project_id]) : BidItem.all %>
                <%= form.collection_select :bid_item_id, items, :id, :code, { include_blank: "Any Item" }, { selected: params[:bid_item_id], class: "form-input" } %>
              </div>

              <div class="filter-group">
                <label>Phase</label>
                <% phase_items = params[:project_id].present? ? Phase.where(project_id: params[:project_id]).order(:name) : Phase.order(:name) %>
                <%= form.collection_select :phase_id, phase_items, :id, :name, { include_blank: "Any Phase", selected: params[:phase_id] }, { class: "form-input" } %>
              </div>

              <div class="filter-group">
                <label>Has quantities</label>
                <%= select_tag :has_quantities,
                  options_for_select([
                    ['Any', ''],
                    ['Yes', 'yes'],
                    ['No', 'no']
                  ], params[:has_quantities].to_s),
                  class: "form-input" %>
              </div>

              <div class="filter-group">
                <label>Spec division</label>
                <% spec_items_scope = if params[:project_id].present?
                  SpecItem.joins(:bid_items).where(bid_items: { project_id: params[:project_id] }).distinct
                else
                  SpecItem.none
                end %>
                <% divisions = spec_items_scope.where.not(division: [nil, '']).distinct.order(:division).pluck(:division) %>
                <%= select_tag :spec_division,
                  options_for_select([['Any Division', '']] + divisions.map { |d| [d, d] }, params[:spec_division].to_s),
                  class: "form-input",
                  data: {
                    "reports-filters-target": "divisionSelect",
                    action: "change->reports-filters#divisionChanged"
                  } %>
              </div>

              <div class="filter-group">
                <label>Spec item</label>
                <% spec_items = spec_items_scope.order(:code) %>
                <select name="spec_item_id" id="spec_item_id" class="form-input" data-reports-filters-target="specItemSelect" <%= 'disabled' if params[:project_id].blank? %>>
                  <option value=""><%= params[:project_id].present? ? 'Any Spec Item' : 'Select project first' %></option>
                  <% spec_items.each do |s| %>
                    <option value="<%= s.id %>" data-division="<%= s.division.to_s %>" <%= 'selected' if params[:spec_item_id].to_s == s.id.to_s %>>
                      <%= "#{s.code} — #{s.description}" %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>
          </details>
        <% end %>
      </div>
    </details>
  </div>

  <% if params[:tab] == 'data' %>
    <div class="table-card">
      <h3 class="mt-0 mb-3">Bid Item Progress (Authorized Reports)</h3>
      <% if @bid_item_progress.present? %>
        <div class="d-flex flex-column gap-5">
          <% @bid_item_progress.each do |row| %>
            <% bid_item = row[:bid_item] %>
            <% placed = row[:placed] %>
            <% target = row[:target] %>
            <% percent = row[:percent] %>

            <div class="border-light rounded-md p-3 bg-card">
              <div class="d-flex justify-between align-center gap-3 flex-wrap">
                <div>
                  <div class="font-bold"><%= bid_item.code %></div>
                  <div class="text-muted text-sm"><%= bid_item.description %></div>
                  <div class="text-muted text-xs">Unit: <%= bid_item.unit %></div>
                </div>
                <div class="text-right text-sm">
                  <% if target.present? %>
                    <div>Target: <%= number_with_precision(target, precision: 3, delimiter: ',') %> <%= bid_item.unit %></div>
                  <% else %>
                    <div class="text-warning">No bid quantity set</div>
                  <% end %>
                  <div>Placed: <%= number_with_precision(placed, precision: 3, delimiter: ',') %> <%= bid_item.unit %></div>
                </div>
              </div>

              <div class="progress-track">
                <% width = if percent.present?
                             [[percent, 0].max, 150].min
                           else
                             0
                           end %>
                <div class="progress-bar"
                     data-controller="progress"
                     data-progress-percent-value="<%= width %>"
                     data-progress-target="bar"></div>
              </div>

              <div class="d-flex justify-between align-center flex-wrap text-sm mt-2">
                <div>
                  <% if percent.present? %>
                    <strong class="<%= 'text-danger' if percent > 100 %>"><%= number_with_precision(percent, precision: 1) %>% complete</strong>
                  <% else %>
                    <strong>Progress unavailable</strong>
                  <% end %>
                </div>
                <% if percent.present? %>
                  <div class="<%= percent > 100 ? 'text-danger' : 'text-muted' %>">(<%= number_with_precision(placed, precision: 2, delimiter: ',') %> / <%= number_with_precision(target, precision: 2, delimiter: ',') %> <%= bid_item.unit %>)</div>
                <% else %>
                  <div class="text-muted">Set bid quantity to enable progress tracking.</div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="table-empty">No bid items found for this context.</div>
      <% end %>
    </div>
  <% elsif params[:tab] == 'imported' %>
    <div class="pagination-container mb-3">
      <%== pagy_nav(@pagy_imported) if @pagy_imported&.pages.to_i > 1 %>
      <div class="pagination-info text-muted text-sm">
        Showing <%= @pagy_imported.from %>–<%= @pagy_imported.to %> of <%= @pagy_imported.count %> imported reports
      </div>
    </div>

    <div class="table-card table-card-scroll">
      <table class="modern-table dashboard-table">
        <thead>
          <tr>
            <th>Imported</th>
            <th>Contract #</th>
            <th>Project Title</th>
            <th>Status</th>
            <th>Confidence</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @imported_reports.any? %>
            <% @imported_reports.each do |ir| %>
              <tr>
                <td><%= ir.created_at.strftime("%b %d") %></td>
                <td class="font-medium"><%= ir.contract_number.presence || "-" %></td>
                <td><%= ir.project_title.presence || "-" %></td>
                <td><span class="status-badge status-<%= ir.status %>"><%= ir.status.humanize %></span></td>
                <td><%= ir.template_confidence.present? ? number_with_precision(ir.template_confidence * 100, precision: 0) + "%" : "-" %></td>
                <td class="text-right">
                  <% if ir.source_docx.attached? %>
                    <%= link_to "DOCX", rails_blob_path(ir.source_docx, disposition: 'attachment'), class: "btn btn-secondary btn-sm" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-5" style="padding: 30px; text-align: center; color: #888;">
                No imported reports yet. Use "Import DOCX" to add one.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <!-- Pagination (top) -->
    <div class="pagination-container mb-3">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      <div class="pagination-info text-muted text-sm">
        Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %> reports
        <% if params[:search_text].present? %>(sorted by relevance)<% end %>
      </div>
    </div>
    
    <div class="table-card table-card-scroll">
      <table class="modern-table dashboard-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Inspector</th>
            <% if params[:search_text].present? %>
              <th>Hits</th>
            <% end %>
            <th>Project</th>
            <th>Phase</th>
            <th>Result</th>
            <% if params[:status] == 'all' %><th>Status</th><% end %>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @reports.any? %>
            <% @reports.each do |report| %>
              <tr class="clickable-row">
                <td class="cell-primary"><%= report.start_date&.strftime("%b %d") %></td>
                <td class="font-medium"><%= report.user.email.split('@').first.titleize %></td>
                <% if params[:search_text].present? %>
                  <td><span class="status-badge" style="background: #e0e7ff; color: #3730a3;"><%= report.search_hits(params[:search_text]) %> found</span></td>
                <% end %>
                <td class="cell-secondary"><%= report.project&.name || "-" %></td>
                <td class="cell-secondary"><%= report.phase&.name || "-" %></td>
                <td>
                  <% if report.result == 'pass' %>
                    <span class="text-success">Pass</span>
                  <% elsif report.result == 'fail' %>
                    <span class="text-danger">Fail</span>
                  <% else %>
                    <span class="text-muted">Pending</span>
                  <% end %>
                </td>
                <% if params[:status] == 'all' %><td><span class="status-badge status-<%= report.status %>"><%= report.status_label %></span></td><% end %>
                <td class="text-right"><%= link_to "View", report_path(report), class: "link-primary" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <% cols = (params[:search_text].present? ? 7 : 6) + (params[:status] == 'all' ? 1 : 0) %>
              <td colspan="<%= cols %>" class="text-center py-5 text-muted">
                No reports found matching your criteria.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <!-- Pagination (bottom) -->
    <div class="pagination-container mt-3">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
      <div class="pagination-info text-muted text-sm">
        Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %> reports
        <% if user_signed_in? %>
          <div data-controller="api-token-easter-egg"
               data-api-token-easter-egg-url-value="<%= api_token_path %>"
               data-api-token-easter-egg-email-value="<%= current_user.email %>"
               class="api-token-easter-egg-wrap">
            <button type="button"
                    class="api-token-easter-egg-btn"
                    aria-label="."
                    data-action="click->api-token-easter-egg#trigger"></button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
