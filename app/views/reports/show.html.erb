<div class="report-container">

  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Projects", path: projects_path },
    { label: @report.project.name, path: project_path(@report.project) },
    { label: "IDR ##{@report.dir_number}", path: "#" }
  ] %>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <div class="report-header">
    <div class="header-title">
      <div>
        <h1>IDR #<%= @report.dir_number %></h1>
        <span class="status-badge status-<%= @report.status %>">
          <%= @report.status_label || "Unknown" %>
        </span>
      </div>
      
      <div class="actions">
        <% if (current_user == @report.user) && (@report.in_progress? || @report.revise?) %>
          <%= link_to "Edit Report", edit_report_path(@report), class: "btn btn-primary" %>
        <% end %>

        <%# NOTE: AI Payload button hidden by default. Re-enable for testing by uncommenting the link below. %>
        <%#= link_to "AI Payload (JSON)", ai_payload_report_path(@report), class: "btn btn-outline-primary", target: "_blank", rel: "noopener" %>
        
        <!-- New async export with progress bar -->
        <div data-controller="report-export" data-report-export-report-id-value="<%= @report.id %>">
          <button type="button" 
                  class="btn btn-primary" 
                  data-report-export-target="button"
                  data-action="click->report-export#startExport">
            Export Word
          </button>
          
          <div class="d-none" data-report-export-target="progress">
            <div class="progress export-progress">
              <div class="progress-bar progress-bar-striped progress-bar-animated" 
                   role="progressbar"
                   aria-valuenow="0" 
                   aria-valuemin="0" 
                   aria-valuemax="100"
                   data-report-export-target="progressBar">
                <span data-report-export-target="progressText">0%</span>
              </div>
            </div>
            <small class="text-muted mt-1 d-block" data-report-export-target="message">Preparing export...</small>
          </div>
          
          <div class="d-none" data-report-export-target="download">
            <a href="#" class="btn btn-success">
              <i class="bi bi-download"></i> Download Export
            </a>
          </div>
        </div>
        
        <%= link_to "Back", reports_path, class: "btn btn-secondary" %>
        <% if current_user == @report.user || current_user.admin? %>
          <%= button_to "Delete", report_path(@report), method: :delete,
              class: "btn btn-clear text-danger",
              form: { data: { turbo_confirm: "Are you sure you want to delete IDR ##{@report.dir_number}? This cannot be undone." } } %>
        <% end %>
      </div>
    </div>
    
    <div class="meta-data-grid">
      <div class="meta-item">
        <label>Start Date</label>
        <div class="value"><%= @report.start_date&.strftime("%b %d, %Y") %></div>
      </div>
      <div class="meta-item">
        <label>End Date</label>
        <div class="value"><%= @report.end_date&.strftime("%b %d, %Y") || "-" %></div>
      </div>
      <% if @report.contract_day_display %>
        <div class="meta-item">
          <label>Contract Progress</label>
          <div class="value">
            <strong><%= @report.contract_day_display %></strong>
            <% if @report.contract_day && @report.calculated_contract_day && @report.contract_day != @report.calculated_contract_day %>
              <br><small class="text-muted">(Manually adjusted from Day <%= @report.calculated_contract_day %>)</small>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="meta-item">
        <label>Inspector</label>
        <div class="value"><%= @report.user.email %></div>
      </div>
      <div class="meta-item">
        <label>Project</label>
        <div class="value"><%= @report.project&.name %></div>
      </div>
      <div class="meta-item">
        <label>Phase</label>
        <div class="value"><%= @report.phase&.name %></div>
      </div>
      <div class="meta-item">
        <label>Shift</label>
        <div class="value"><%= @report.shift_start %> - <%= @report.shift_end %></div>
      </div>
    </div>
  </div>

  <div class="report-section">
    <h3>Weather Readings</h3>
    <div class="weather-grid">
      <div class="weather-col">
        <label>Start of Shift</label>
        <div><strong>Temp:</strong> <%= @report.temp_1 %>°F</div>
        <div><strong>Cond:</strong> <%= @report.weather_summary_1 %></div>
        <div><strong>Wind:</strong> <%= @report.wind_1 %></div>
        <div><strong>Precip:</strong> <%= @report.precip_1 %></div>
      </div>
      <div class="weather-col">
        <label>Mid Shift</label>
        <div><strong>Temp:</strong> <%= @report.temp_2 %>°F</div>
        <div><strong>Cond:</strong> <%= @report.weather_summary_2 %></div>
        <div><strong>Wind:</strong> <%= @report.wind_2 %></div>
        <div><strong>Precip:</strong> <%= @report.precip_2 %></div>
      </div>
      <div class="weather-col">
        <label>End of Shift</label>
        <div><strong>Temp:</strong> <%= @report.temp_3 %>°F</div>
        <div><strong>Cond:</strong> <%= @report.weather_summary_3 %></div>
        <div><strong>Wind:</strong> <%= @report.wind_3 %></div>
        <div><strong>Precip:</strong> <%= @report.precip_3 %></div>
      </div>
    </div>
  </div>

  <div class="report-section">
    <h3>Site Compliance</h3>

    <% if @report.yes_deficiency? || @report.cdr? || @report.ncr? %>
      <div class="alert alert-danger">
        <strong>Deficiency Reported:</strong> <%= @report.deficiency_status.humanize %>
        <p class="mt-1"><%= @report.deficiency_desc %></p>
      </div>
    <% end %>

    <% if @report.safety_yes? %>
      <div class="alert alert-danger">
        <strong>Safety Incident Reported</strong>
        <p class="mt-1"><%= @report.safety_desc %></p>
      </div>
    <% end %>

    <div class="compliance-grid">
      <% render_comp_item = ->(label, val, note_field) { %>
        <div class="compliance-item">
          <div>
            <span class="compliance-label"><%= label %></span>
            <% if val.to_s.end_with?('no') %>
               <span class="label-badge label-badge--fail">Non-Compliant</span>
            <% elsif val.to_s.end_with?('yes') %>
               <span class="label-badge label-badge--pass">Compliant</span>
            <% else %>
               <span class="label-badge label-badge--muted">N/A</span>
            <% end %>
          </div>
          
          <% if val.to_s.end_with?('no') && note_field.present? %>
            <div class="compliance-note-box mt-2">
              <%= note_field %>
            </div>
          <% end %>
        </div>
      <% } %>

      <% render_comp_item.call("Traffic Control", @report.traffic_control, @report.traffic_control_note) %>
      <% render_comp_item.call("Environmental", @report.environmental, @report.environmental_note) %>
      <% render_comp_item.call("Security", @report.security, @report.security_note) %>
      <% render_comp_item.call("Air Ops", @report.air_ops_coordination, @report.air_ops_note) %>
      <% render_comp_item.call("SWPPP Controls", @report.swppp_controls, @report.swppp_note) %>
      <% render_comp_item.call("Phasing Exhibit", @report.phasing_compliance, @report.phasing_compliance_note) %>
    </div>
  </div>

  <%= turbo_frame_tag "report_section_checklists",
      src: section_report_path(@report, section: "checklists"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading specification checklists...</p>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_qa_entries",
      src: section_report_path(@report, section: "qa_entries"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading quality assurance entries...</p>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_lab_test_results",
      src: section_report_path(@report, section: "lab_test_results"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading concrete lab results...</p>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_core_locations",
      src: section_report_path(@report, section: "core_locations"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading core sample locations...</p>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_workforce_equipment",
      src: section_report_path(@report, section: "workforce_equipment"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading workforce and equipment logs...</p>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_quantities",
      src: section_report_path(@report, section: "quantities"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading quantity entries...</p>
    </div>
  <% end %>

  <% if @report.additional_activities.present? || @report.additional_info.present? || @report.commentary.present? %>
    <div class="report-section">
      <h3>Additional Information</h3>
      
      <% if @report.additional_activities.present? %>
        <div class="mb-5">
          <label class="font-bold text-muted block mb-1">Additional Activities</label>
          <div class="pre-wrap bg-muted p-3 rounded-sm border-light"><%= @report.additional_activities %></div>
        </div>
      <% end %>

      <% if @report.additional_info.present? %>
        <div class="mb-5">
          <label class="font-bold text-muted block mb-1">Additional Info</label>
          <div class="pre-wrap bg-muted p-3 rounded-sm border-light"><%= @report.additional_info %></div>
        </div>
      <% end %>

      <% if @report.commentary.present? %>
        <div>
          <label class="font-bold text-muted block mb-1">General Commentary</label>
          <div class="pre-wrap bg-muted p-3 rounded-sm border-light"><%= @report.commentary %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= turbo_frame_tag "report_section_attachments",
      src: section_report_path(@report, section: "attachments"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading attachments...</p>
    </div>
  <% end %>

  <div class="action-bar-container">
    <% if (@report.in_progress? || @report.revise?) && current_user == @report.user %>
      <div class="primary-actions">
        <%= button_to "Submit for Review", submit_for_qc_report_path(@report), method: :post, class: "btn btn-primary" %>
        <span class="hint-text">(Moves report to Review tab)</span>
      </div>
    <% end %>

    <% if @report.review? && current_user.can_qc? && @report.user_id != current_user.id %>
      <div class="qc-panel">
        <div class="qc-header-row">
          <h4>Review Decision</h4>
          <%= button_to "Approve & Finalize", approve_report_path(@report), method: :post, class: "btn btn-success" %>
        </div>
        
        <div class="qc-divider"></div>
        
        <div class="qc-revision-row">
          <%= form_with url: request_revision_report_path(@report), method: :post, local: true, class: "revision-form" do |f| %>
            <label class="revision-label">Return for Revision:</label>
            <div class="input-group">
              <%= text_area_tag 'note', (@revision_note || params[:note]), placeholder: "Enter reason for rejection...", rows: 1, class: "form-input revision-input" %>
              <%= f.submit "Return to Inspector", class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "report_section_audit_log",
      src: section_report_path(@report, section: "audit_log"),
      loading: :lazy do %>
    <div class="report-section">
      <p class="text-muted-sm">Loading audit log...</p>
    </div>
  <% end %>

</div>
